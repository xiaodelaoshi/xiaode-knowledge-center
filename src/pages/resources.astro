---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const buyingDownloads = { word: '買房看屋檢查清單_台灣版.docx', pdf: '買房看屋檢查清單_台灣版.pdf' };
const sellingDownloads = { word: '賣房準備清單_台灣屋主版.docx', pdf: '賣房準備清單_台灣屋主版.pdf' };
const resources = [
  { id: 'buying', number: '01', title: '買房看房檢查清單', intro: '帶看時不只看裝潢，這些條件也要記下來。', items: ['屋況：採光、通風、漏水痕跡與管線狀況', '環境：噪音、採買、停車、通勤與日夜差異', '文件：坪數、格局、管理費、屋齡與交易條件'], article: '第一次看房先看什麼' },
  { id: 'selling', number: '02', title: '賣房準備清單', intro: '先把條件整理好，才能讓定價與溝通更有效率。', items: ['整理權狀、稅單、格局與修繕紀錄', '盤點出售原因、交屋時間與價格底線', '提前處理影響看屋的雜物、屋況與居住安排'], article: '屋主已經委託別家怎麼談' },
  { id: 'accident', number: '03', title: '交通事故初步處理卡', intro: '事故發生後先穩定處理，讓後續權益有依據。', items: ['確認安全並報警，必要時先就醫', '保留現場、車損、傷勢、對話與診斷資料', '留意保險、調解與告訴期間，重要文件不要急著丟'], article: '機車族車禍後五個關鍵動作' },
];
---
<BaseLayout title="免費實用資源" description="小德老師知識中心提供買房、賣房與交通事故的免費實用清單。">
  <section class="resource-hero"><div class="container"><p class="eyebrow">FREE RESOURCES</p><h1>把複雜的事，<br/>整理成一張能用的清單。</h1><p>這些資源以知識整理為目的，適合先存下來、需要時再回來看。</p></div></section>
  <section class="section"><div class="container cards">{resources.map((resource) => <article id={resource.id}><span>{resource.number}</span><h2>{resource.title}</h2><p>{resource.intro}</p><ul>{resource.items.map((item) => <li>{item}</li>)}</ul><div class="actions">{resource.id === 'buying' && <><a class="button file-word" href={`${base}downloads/${buyingDownloads.word}`} download>下載 Word 版</a><a class="button file-pdf" href={`${base}downloads/${buyingDownloads.pdf}`} download>下載 PDF 版</a></>}{resource.id === 'selling' && <><a class="button file-word" href={`${base}downloads/${sellingDownloads.word}`} download>下載 Word 版</a><a class="button file-pdf" href={`${base}downloads/${sellingDownloads.pdf}`} download>下載 PDF 版</a></>}<a class="button" href={`${base}search/?q=${encodeURIComponent(resource.article)}`}>閱讀相關文章</a></div></article>)}</div></section>
</BaseLayout>
<style>
.resource-hero{padding:105px 0 80px;background:linear-gradient(135deg,#eaf6ff,#fff8e9)}.resource-hero h1{max-width:850px}.resource-hero>div>p:last-child{max-width:560px;color:var(--muted);font-size:1.08rem}.cards{display:grid;gap:20px}.cards article{padding:32px;border:1px solid var(--line);background:#fff;border-radius:24px;box-shadow:var(--shadow)}.cards article>span{color:var(--gold);font-weight:900;letter-spacing:.12em}.cards h2{margin:10px 0;color:var(--navy);font-size:1.55rem}.cards p{color:var(--muted)}.cards ul{padding-left:1.3rem}.cards li{margin:7px 0}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.file-word{color:#fff;background:#185abd;border-color:#185abd}.file-pdf{color:#fff;background:#c43b34;border-color:#c43b34}@media(max-width:600px){.resource-hero{padding:75px 0 55px}}
</style>

