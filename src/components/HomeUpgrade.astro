---
const { observations = [], section = 'all' } = Astro.props;
const base = import.meta.env.BASE_URL;
const needs = [
  { icon: '買', title: '我想買房', text: '從看房、自備款到區域選擇，先建立自己的判斷。', href: `${base}categories/real-estate/` },
  { icon: '賣', title: '我想賣房', text: '理解委託、定價、議價與成交前該準備的事。', href: `${base}categories/real-estate/` },
  { icon: '法', title: '我有稅務或法律問題', text: '繼承、贈與、房地合一與事故後的常見問題。', href: `${base}categories/tax-law/` },
  { icon: '聊', title: '我想交流或合作', text: '房仲實戰、團隊管理、AI 與內容創作的經驗交流。', href: `${base}contact/` },
];
const faqs = [
  ['這裡的法律與稅務內容可以直接當作個案答案嗎？', '不建議。文章是幫你建立判斷架構；每個案件的取得日期、契約、家族關係與證據都不同，重要決定前仍應確認專業意見。'],
  ['想買房或賣房，應該先看哪一區？', '先從你的生活圈、通勤、預算與持有目的開始，再閱讀區域觀察與實務文章，不必急著追熱門名詞。'],
  ['如何最快找到需要的內容？', '可直接用首頁搜尋框輸入關鍵字，例如「繼承房屋」、「車禍」、「首購」或「房仲 AI」。'],
];
---
{(section === 'all' || section === 'needs') && <section class="section needs-section">
  <div class="container">
    <div class="section-head"><div><p class="eyebrow">START HERE</p><h2>你現在需要哪一種協助？</h2></div><p>不必先懂所有專有名詞，從你正在面對的問題開始就好。</p></div>
    <div class="needs-grid">{needs.map((need) => <a class="need-card" href={need.href}><span>{need.icon}</span><h3>{need.title}</h3><p>{need.text}</p><b>開始了解 →</b></a>)}</div>
  </div>
</section>}
{(section === 'all' || section === 'trust') && <section class="section trust"><div class="container trust-grid"><div class="trust-copy"><p class="eyebrow">ABOUT XIAODE</p><h2>不只分享資訊，也陪你把問題想清楚。</h2><p>小德老師以高雄房市與第一線實務為起點，整理買賣、稅務法律、房仲工作、團隊管理與 AI 應用。每篇內容都希望讓你少一點焦慮，多一個能做判斷的方向。</p><div class="trust-points"><span>高雄房市觀察</span><span>房地產實務</span><span>白話知識整理</span></div><a class="button primary" href={`${base}about/`}>認識小德老師</a></div><aside class="trust-note"><small>小德老師的原則</small><strong>說人話<br/>說實話<br/>有溫度</strong><p>內容以知識分享與經驗整理為主；需要個案判斷時，會先把條件釐清。</p></aside></div></section>}
{(section === 'all' || section === 'observations') && <section class="section observations"><div class="container"><div class="section-head"><div><p class="eyebrow">XIAODE'S NOTE</p><h2>小德老師的最新觀察</h2></div><p>從房市、法律與真實案例中，看見值得提前準備的事。</p></div><div class="observation-grid">{observations.map((article: any) => <a href={`${base}articles/${article.id}/`}><span>{article.data.category}</span><h3>{article.data.title}</h3><p>{article.data.description}</p><b>閱讀觀察 →</b></a>)}</div></div></section>}
{(section === 'all' || section === 'resources') && <section class="section resources"><div class="container"><div class="section-head"><div><p class="eyebrow">FREE RESOURCES</p><h2>拿了就能用的實用資源</h2></div><a class="button" href={`${base}resources/`}>查看全部資源</a></div><div class="resource-grid"><a href={`${base}resources/#buying`}><span>01</span><h3>買房看房檢查清單</h3><p>第一次看房時，幫你記得該看屋況、環境與文件。</p><b>前往下載 →</b></a><a href={`${base}resources/#selling`}><span>02</span><h3>賣房準備清單</h3><p>把委託前的資料、屋況與溝通重點先整理好。</p><b>前往下載 →</b></a><a href={`${base}resources/#accident`}><span>03</span><h3>交通事故初步處理卡</h3><p>事故後先保留什麼、注意什麼，用一張卡快速掌握。</p><b>前往下載 →</b></a></div></div></section>}
{(section === 'all' || section === 'faq') && <section class="section faq"><div class="container faq-grid"><div><p class="eyebrow">FAQ</p><h2>先解答幾個常見問題</h2><p>看完還是不確定？你可以透過 Messenger 將情況告訴我。</p><a class="button primary" href={`${base}contact/`}>先整理問題再聯絡</a></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>}
<style>
.needs-section,.observations{background:#fff}.needs-grid,.observation-grid,.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.needs-grid{grid-template-columns:repeat(4,1fr)}.need-card,.observation-grid>a,.resource-grid>a{display:flex;min-height:220px;padding:24px;border:1px solid var(--line);background:#fff;border-radius:var(--radius);flex-direction:column;transition:.22s}.need-card:hover,.observation-grid>a:hover,.resource-grid>a:hover{transform:translateY(-4px);border-color:var(--gold);box-shadow:var(--shadow)}.need-card>span{display:grid;width:46px;height:46px;place-items:center;color:#fff;background:var(--navy);border-radius:14px;font-weight:900}.need-card h3,.observation-grid h3,.resource-grid h3{margin:20px 0 8px;color:var(--navy);font-size:1.15rem}.need-card p,.observation-grid p,.resource-grid p{margin:0;color:var(--muted);font-size:.88rem}.need-card b,.observation-grid b,.resource-grid b{margin-top:auto;padding-top:17px;color:var(--gold);font-size:.83rem}.observation-grid>a span,.resource-grid>a span{color:var(--gold);font-size:.76rem;font-weight:900;letter-spacing:.1em}.trust{background:linear-gradient(135deg,#edf7ff,#fff8e9)}.trust-grid,.faq-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:58px;align-items:center}.trust-copy>p:not(.eyebrow),.faq-grid>div>p:not(.eyebrow){max-width:640px;color:var(--muted);font-size:1.05rem}.trust-points{display:flex;flex-wrap:wrap;gap:9px;margin:23px 0}.trust-points span{padding:5px 11px;border-radius:999px;color:var(--navy);background:#fff;font-size:.8rem;font-weight:800}.trust-note{padding:42px;color:#fff;background:var(--navy);border-radius:28px;box-shadow:var(--shadow)}.trust-note small{color:#f2c230;letter-spacing:.13em;font-weight:900}.trust-note strong{display:block;margin:14px 0;font-size:clamp(2rem,4vw,3.3rem);line-height:1.3}.trust-note p{margin:0;color:rgba(255,255,255,.72)}.resources{background:linear-gradient(135deg,#fffaf0,#fff)}.faq{background:#fff}.faq-list{display:grid;gap:10px}.faq details{padding:18px 20px;border:1px solid var(--line);border-radius:16px;background:var(--cream)}.faq summary{cursor:pointer;color:var(--navy);font-weight:850}.faq details p{margin:12px 0 0;color:var(--muted);font-size:.9rem}@media(max-width:900px){.needs-grid{grid-template-columns:repeat(2,1fr)}.trust-grid,.faq-grid{grid-template-columns:1fr}.observation-grid,.resource-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.needs-grid,.observation-grid,.resource-grid{grid-template-columns:1fr}.need-card{min-height:190px}}
</style>
